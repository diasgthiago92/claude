# CNPJ Explorer - Variáveis de Ambiente
# Copie para .env e configure com seus dados

# ======================
# BrasilAPI
# ======================
BRASILAPI_URL=https://brasilapi.com.br/api/cnpj/v1/
BRASILAPI_TIMEOUT=5

# ======================
# Meu CNPJ (Opcional - API Paga)
# ======================
# Obter em: https://www.meucnpj.com
MEUCNPJ_API_KEY=
MEUCNPJ_URL=https://www.meucnpj.com/api/v1/

# ======================
# Cache
# ======================
CACHE_ENABLED=true
CACHE_TTL=86400
CACHE_DIR=./cache

# ======================
# Logging
# ======================
LOG_LEVEL=INFO
LOG_FILE=./logs/cnpj_explorer.log

# ======================
# Paralelização
# ======================
MAX_WORKERS=4
TIMEOUT=5

# ======================
# Receita Federal (Offline)
# ======================
RECEITA_FEDERAL_DATA_DIR=./data/receita-federal
RECEITA_FEDERAL_ENABLE=false

# ======================
# Google Custom Search (busca de candidatos LinkedIn dos sócios)
# ======================
# Cadastro gratuito (100 buscas/dia): https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CSE_ID=c2249930fb22b4d19
LINKEDIN_SEARCH_MAX_RESULTS=3

# ======================
# Portal da Transparência (contratos/convênios/sanções com Governo Federal)
# ======================
# Cadastro gratuito: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_TOKEN=

# ======================
# Relatório Completo (--full)
# ======================
RELATORIO_OUTPUT_DIR=./output
